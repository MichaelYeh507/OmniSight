# Raw recordings never go in git (share via the Drive folder). Keep the README.
data/raw/*
!data/raw/README.md

# Derived outputs and large media
people_out/
*.ply
*.mp4
*.mov
# except the demo cuts, kept small (under 50 MB each) so teammates can watch them from the repo
!demo/*.mp4

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node / Vite
node_modules/
viewer/dist/
viewer/.vite/
viewer/public/scenes/stress/

# Misc
.env
.DS_Store
Thumbs.db
*.log

# Vite dep cache if the dev server is ever started from the repo root by mistake
.vite/

# Pipeline output staging (scenes are produced here, then copied into viewer/public/scenes) and downloaded ML checkpoints
data/scenes/
*.pt
