{
  "name": "omnisight-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:ssl": "vite --mode ssl --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test \"test/**/*.test.js\"",
    "validate": "node scripts/validate-scene.mjs",
    "stress": "node scripts/make-scene.mjs --out public/scenes/stress --points 800000 --duration 60 --person 5:12",
    "reverse": "adb reverse tcp:5173 tcp:5173"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "vite": "^8.3.0"
  }
}
